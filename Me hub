-- =========================================================
-- HELPERS
-- =========================================================
local function corner(object, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = object
	return c
end

local function stroke(object, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or C.Stroke
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.Parent = object
	return s
end

local function addScale(object)
	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = object
	return scale
end

local function makeLabel(parent, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or C.Text
	label.Font = font or Enum.Font.GothamMedium
	label.TextSize = size or 12
	label.Parent = parent
	return label
end

local function createGeo(parent, position, size, color, rotation, transparency)
	local object = Instance.new("Frame")
	object.AnchorPoint = Vector2.new(0.5, 0.5)
	object.Position = position
	object.Size = size
	object.BackgroundColor3 = color
	object.BackgroundTransparency = transparency or 0.85
	object.BorderSizePixel = 0
	object.Rotation = rotation or 45
	object.Parent = parent
	corner(object, 6)
	return object
end

local function createCoreIcon(parent, color)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromOffset(20, 20)
	holder.BackgroundTransparency = 1
	holder.Parent = parent

	local outer = Instance.new("Frame")
	outer.AnchorPoint = Vector2.new(0.5, 0.5)
	outer.Position = UDim2.fromScale(0.5, 0.5)
	outer.Size = UDim2.fromOffset(14, 14)
	outer.BackgroundTransparency = 1
	outer.Rotation = 45
	outer.Parent = holder
	stroke(outer, color, 2, 0.05)

	local center = Instance.new("Frame")
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.fromOffset(5, 5)
	center.BackgroundColor3 = color
	center.BorderSizePixel = 0
	center.Parent = holder
	corner(center, 5)

	-- Sürekli nabız ve döner efekt
	task.spawn(function()
		while outer and outer.Parent do
			TweenService:Create(outer, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Rotation = outer.Rotation + 90}):Play()
			task.wait(1.2)
		end
	end)

	return holder
end

local function createCloseIcon(parent, color)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromOffset(20, 20)
	holder.BackgroundTransparency = 1
	holder.Parent = parent

	local line1 = Instance.new("Frame")
	line1.AnchorPoint = Vector2.new(0.5, 0.5)
	line1.Position = UDim2.fromScale(0.5, 0.5)
	line1.Size = UDim2.fromOffset(15, 2)
	line1.BackgroundColor3 = color
	line1.BorderSizePixel = 0
	line1.Rotation = 45
	line1.Parent = holder
	corner(line1, 2)

	local line2 = line1:Clone()
	line2.Rotation = -45
	line2.Parent = holder

	return holder
end

