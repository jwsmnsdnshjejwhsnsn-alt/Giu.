local menuBusy = false
local menuOpen = false

local function toggleMenu(state)
	if menuBusy or state == menuOpen then return end
	menuBusy = true
	menuOpen = state

	local twInfo = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	if state then
		mainFrame.Visible = true
		openBtn.Visible = false
		mainFrame.Size = UDim2.fromScale(0.6, 0.35)
		mainFrame.BackgroundTransparency = 1
		mainStroke.Transparency = 1
		mainFrame.Position = UDim2.new(0.5, 0, 0.55, 0)

		TweenService:Create(mainFrame, twInfo, {Size = UDim2.fromScale(0.7, 0.45), BackgroundTransparency = 0, Position = UDim2.fromScale(0.5, 0.5)}):Play()
		TweenService:Create(mainStroke, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Transparency = 0}):Play()
		TweenService:Create(blurEffect, TweenInfo.new(0.45), {Size = 18}):Play()

		task.wait(0.55)
		menuBusy = false
	else
		local closeTw = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Size = UDim2.fromScale(0.6, 0.35), BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.55, 0)})
		TweenService:Create(mainStroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
		TweenService:Create(blurEffect, TweenInfo.new(0.4), {Size = 0}):Play()

		closeTw:Play()
		closeTw.Completed:Wait()

		mainFrame.Visible = false
		openBtn.Visible = true
		openBtn.BackgroundTransparency = 1
		TweenService:Create(openBtn, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()

		menuBusy = false
	end
end

openBtn.MouseButton1Click:Connect(function() toggleMenu(true) end)
closeBtn.MouseButton1Click:Connect(function() toggleMenu(false) end)

